// use prisma-8

//Entidad
model Factura {
  codigo String @unique
  fecha Date
  cod_cliente Int32
  total Double
  descuento Double
  iva Double
  total_a_pagar Double

  //Se define la relación con la entidad DetalleFactura
  detalles_factura DetalleFactura[]
}

//Lo que va a estar dentro 
type DetalleFactura {
  codigo Int32
  cod_producto Int32
  cantidad Int32
  subtotal Double
}
