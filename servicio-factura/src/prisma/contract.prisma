// use prisma-8

//Entidad
model Factura {
  codigo String @unique
  fecha Date
  cod_cliente Int32
  total Decimal128
  descuento Decimal128
  iva Decimal128
  total_a_pagar Decimal128

  //Se define la relación con la entidad DetalleFactura
  detalles_factura DetalleFactura[]
}

//Lo que va a estar dentro 
type DetalleFactura {
  codigo Int32
  cod_factura Int32
  cod_producto Int32
  cantidad Int32
  subtotal Decimal128
}
